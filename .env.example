# GEMINI_API_KEY: obrigatória para os endpoints de IA (/api/ai/pitch, /api/ai/test).
# Runtime env var (usada pelo servidor Express) — define-a como variável de ambiente
# normal no Coolify, não precisa de estar disponível no momento do build.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DATABASE_URL: obrigatória — string de ligação Postgres onde os leads, notas,
# lembretes, visitas, registos de contacto e definições são guardados.
# Runtime env var. No Coolify, cria um recurso "Postgres" e usa a connection
# string interna que ele te dá (ex: postgres://user:pass@nome-do-servico:5432/db).
DATABASE_URL="postgres://user:password@host:5432/leadhunter"

# PORT: porta onde o servidor Express escuta dentro do container (default: 3000).
PORT=3000

# VITE_LOGIN_EMAIL / VITE_LOGIN_PASSWORD: credenciais de acesso à app.
# ATENÇÃO: estas são "build args", não variáveis de runtime — o Vite embebe-as
# no bundle do frontend durante `npm run build` / `docker build`. No Coolify,
# define-as como "Build Variables" (não apenas "Environment Variables").
# Se não forem definidas, o default é goncalo.fcmacedo@gmail.com / leadhunter.
VITE_LOGIN_EMAIL="MY_LOGIN_EMAIL"
VITE_LOGIN_PASSWORD="MY_LOGIN_PASSWORD"
